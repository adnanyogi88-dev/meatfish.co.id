<!doctype html>
<html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Masuk & Daftar | Meatfish</title></head><body>
<main class="auth-shell"><a class="brand" href="/">MEATFISH</a><section class="auth-card"><h1 id="title">Masuk ke akun Meatfish</h1><div class="tabs"><button data-mode="login" class="active">Masuk</button><button data-mode="register">Daftar</button></div><form id="authForm"><label id="nameLabel" hidden>Nama lengkap<input name="name" maxlength="80"></label><label>Email<input name="email" type="email" autocomplete="email" required maxlength="254"></label><label>Password<input name="password" type="password" minlength="8" required autocomplete="current-password"></label><button class="primary" type="submit" id="submit">Masuk</button></form><button id="google" class="secondary" type="button">Lanjutkan dengan Google</button><button id="forgot" class="link" type="button">Lupa password?</button><p id="status" role="status"></p><p class="hint">Daftar untuk mengakses program affiliate Meatfish.</p></section></main>
<script type="module" src="/affiliate/auth.js"></script>
<style>
*{box-sizing:border-box}body{margin:0;font:16px/1.6 system-ui;background:linear-gradient(140deg,#092f37,#0b5965 65%,#e64c35);min-height:100vh;color:#143037}.auth-shell{min-height:100vh;display:grid;place-items:center;padding:28px}.brand{position:absolute;top:24px;left:28px;color:white;font-weight:900;letter-spacing:.13em;text-decoration:none}.auth-card{width:min(100%,440px);background:white;border-radius:22px;padding:30px;box-shadow:0 20px 65px #001d2855}.auth-card h1{margin:0 0 18px;font-size:27px}.tabs{display:flex;gap:8px;margin:20px 0}.tabs button,.secondary,.link{background:#edf4f4;border:1px solid #dce6e4;border-radius:10px;padding:11px 14px;cursor:pointer}.tabs button.active,.primary{background:#0b5965;color:white;border-color:#0b5965}.tabs button{flex:1}.auth-card label{display:grid;gap:6px;margin:14px 0;font-weight:650}.auth-card input{padding:12px;border:1px solid #cad8d8;border-radius:9px;font:inherit}.primary,.secondary,.link{width:100%;margin-top:10px;font:inherit;cursor:pointer}.hint{color:#667b7e;font-size:13px}.auth-card #status{min-height:25px;color:#a13b2c;font-size:14px}
</style>
</body></html>