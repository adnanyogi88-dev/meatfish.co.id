<!doctype html>
<html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Dashboard | Meatfish Affiliate</title></head><body>
<header><a href="/" class="brand">MEATFISH <small>Affiliate Center</small></a><button id="logout">Keluar</button></header><main>
<section class="panel"><p class="eyebrow">DASHBOARD MEATFISH</p><h1 id="welcome">Memuat akun...</h1><p id="identity"></p><div id="roleBadge" class="notice">Memeriksa hak akses...</div></section><div id="status" class="notice">Memuat data...</div>
<section id="memberView" hidden><h2>Dashboard Member</h2><div class="cards"><article class="stat"><span>Status</span><strong>Member</strong></article></div><section class="panel"><h3>Profil Anggota</h3><form id="profileForm"><label>Nama tampilan<input id="displayName" maxlength="80" required></label><button class="primary">Simpan profil</button></form></section><section class="panel"><h3>Program Affiliate</h3><p>Ajukan akun affiliate untuk mendapatkan kode referral setelah disetujui admin.</p><form id="affiliateForm"><label>Alasan bergabung<textarea id="motivation" maxlength="500"></textarea></label><button class="primary">Ajukan menjadi Affiliate</button></form><p id="applicationStatus"></p></section></section>
<section id="affiliateView" hidden><h2>Dashboard Affiliate</h2><div class="cards"><article class="stat"><span>Referral terdaftar</span><strong id="referralCount">0</strong></article><article class="stat"><span>Total komisi</span><strong id="commissionTotal">Rp0</strong></article><article class="stat"><span>Saldo tersedia</span><strong id="pendingTotal">Rp0</strong></article></div><section class="panel"><h3>Link Referral</h3><p id="refLink" class="code"></p><button id="copyRef" class="primary">Salin link</button></section><section class="panel"><h3>Riwayat Komisi</h3><div id="affiliateCommissions" class="table-wrap"></div></section><section class="panel"><h3>Ajukan Penarikan</h3><p>Saldo tersedia: <strong id="withdrawalBalance">Rp0</strong></p><form id="withdrawalForm"><div class="fields"><label>Nominal (minimum Rp50.000)<input id="withdrawalAmount" type="number" min="50000" step="1000" required></label><label>Metode<select id="payoutMethod"><option value="bank">Transfer bank</option><option value="ewallet">E-wallet</option></select></label><label>Nama pemilik<input id="recipientName" maxlength="100" required></label><label>Nomor rekening / e-wallet<input id="payoutDestination" maxlength="160" required></label></div><button id="withdrawalSubmit" class="primary">Ajukan penarikan</button></form></section><section class="panel"><h3>Riwayat Penarikan</h3><div id="affiliatePayouts" class="table-wrap"></div></section><section class="panel"><h3>Referral</h3><div id="affiliateReferrals" class="table-wrap"></div></section></section>
<section id="adminView" hidden><h2>Dashboard Admin</h2><div class="cards"><article class="stat"><span>Total anggota</span><strong id="memberTotal">0</strong></article><article class="stat"><span>Pengajuan affiliate</span><strong id="applicationTotal">0</strong></article><article class="stat"><span>Total komisi</span><strong id="adminCommissionTotal">Rp0</strong></article></div><section class="panel"><h3>Anggota & Hak Akses</h3><div id="membersTable" class="table-wrap"></div></section><section class="panel"><h3>Pengajuan Affiliate</h3><div id="applicationsTable" class="table-wrap"></div></section><section class="panel"><h3>Catat Komisi</h3><form id="commissionForm" class="fields"><label>Affiliate<select id="commissionAffiliate" required></select></label><label>Nominal (Rp)<input id="commissionAmount" type="number" min="1" required></label><label>Catatan<input id="commissionNote" maxlength="250"></label><button class="primary">Simpan komisi</button></form><div id="adminCommissions" class="table-wrap"></div></section><section class="panel"><h3>Pengajuan Penarikan Affiliate</h3><div id="adminPayoutRequests" class="table-wrap"></div></section></section>
</main><script type="module" src="/affiliate/dashboard.js"></script>
<style>
:root{--ink:#143037;--brand:#0b5965;--accent:#e64c35;--line:#dce6e4;--soft:#f3f7f6}*{box-sizing:border-box}body{margin:0;background:#f5f8f7;color:var(--ink);font:15px/1.55 system-ui}header{padding:16px max(4%,calc((100% - 1120px)/2));display:flex;justify-content:space-between;align-items:center;background:white;border-bottom:1px solid var(--line)}.brand{font-weight:900;color:var(--brand);text-decoration:none;letter-spacing:.08em}.brand small{display:block;font-size:11px;letter-spacing:0;color:#667b7e}button,input,select,textarea{font:inherit}button{border:1px solid var(--line);border-radius:9px;padding:9px 13px;cursor:pointer;background:white;color:var(--ink)}main{width:min(1120px,92%);margin:28px auto 70px}.panel{background:white;border:1px solid var(--line);border-radius:15px;padding:20px;margin:16px 0}.eyebrow{color:var(--accent);font-weight:800;letter-spacing:.12em}.notice{padding:12px;border-radius:9px;background:#e8f2f1;margin:12px 0}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}.stat{background:#e8f2f1;padding:17px;border-radius:12px}.stat strong{display:block;font-size:27px}.fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}.fields label,label{display:grid;gap:5px;margin:10px 0}input,select,textarea{padding:10px;border:1px solid #cad8d8;border-radius:9px;width:100%}.primary{background:var(--brand);color:white;border-color:var(--brand)}.code{overflow-wrap:anywhere;background:#eef4f3;padding:12px;border-radius:9px}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:14px}th,td{text-align:left;padding:10px;border-bottom:1px solid var(--line);vertical-align:top}th{background:#f2f6f5}.muted{color:#64777a}[hidden]{display:none!important}@media(max-width:600px){main{margin-top:16px}.panel{padding:14px}}
</style></body></html>