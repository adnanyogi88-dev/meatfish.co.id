---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import PostCards from '../components/PostCards.astro';
import { posts } from '../lib/posts';
const latest = posts.filter(({ frontmatter: data }) => /franchise|kemitraan|supplier|pasokan|usaha|bisnis/i.test(data.title)).slice(0, 6);
const products = [
  { title: 'Daging untuk kebutuhan usaha', image: '/wp-content/uploads/2024/07/Beef-Slice-Low-Fat-1.webp', text: 'Konsultasikan kebutuhan daging slice, steak, rendang, dan potongan lainnya.' },
  { title: 'Ikan dan seafood', image: '/wp-content/uploads/2024/07/Dori-Fillet-2.webp', text: 'Tanyakan pilihan ikan fillet, udang, cumi, dan produk seafood sesuai menu usaha.' },
  { title: 'Produk beku untuk bisnis kuliner', image: '/wp-content/uploads/2024/07/Udang-CPND-2.webp', text: 'Diskusikan kategori produk, kebutuhan stok, dan spesifikasi sebelum meminta penawaran.' },
];
---
<BaseLayout>
  <section class="reference-hero"><div class="container reference-hero-grid"><div class="reference-hero-copy">
    <span class="reference-kicker">Meat &amp; Fish · Kemitraan &amp; B2B</span>
    <h1>Kemitraan frozen food dan pasokan untuk bisnis Anda</h1>
    <p>Kenali peluang kemitraan toko Meatfish dan konsultasikan kebutuhan daging, ikan, seafood, serta frozen food untuk restoran, katering, reseller, dan usaha kuliner.</p>
    <div class="reference-actions"><WhatsAppButton label="Konsultasi Kemitraan" purpose="kemitraan" /><a class="reference-link" href="/pasokan-untuk-bisnis/">Lihat Layanan B2B →</a></div>
    <div class="reference-badges"><span>Kemitraan toko</span><span>Kebutuhan pasokan usaha</span><span>Pengajuan pemasok</span></div>
  </div></div></section>
  <section class="section-tight"><div class="container">
    <div class="reference-section-head"><h2>Pilih kebutuhan Anda</h2><p>Temukan informasi dan jalur konsultasi yang sesuai dengan tujuan bisnis.</p></div>
    <div class="grid service-grid">
      <article class="card"><div class="card-body"><span class="eyebrow dark">Calon mitra</span><h3>Kemitraan toko Meatfish</h3><p>Bahas konsep toko, lokasi, kebutuhan investasi, dan ruang lingkup dukungan bersama tim kemitraan.</p><a class="text-link" href="/gabung-kemitraan/">Pelajari Kemitraan →</a></div></article>
      <article class="card"><div class="card-body"><span class="eyebrow dark">Pembelian untuk usaha</span><h3>Pasokan untuk bisnis kuliner</h3><p>Sampaikan kategori produk, perkiraan volume, lokasi, dan jadwal kebutuhan untuk meminta penawaran.</p><a class="text-link" href="/pasokan-untuk-bisnis/">Minta Penawaran B2B →</a></div></article>
      <article class="card"><div class="card-body"><span class="eyebrow dark">Pemasok produk</span><h3>Ajukan produk Anda</h3><p>Perkenalkan usaha, spesifikasi produk, kapasitas pasokan, dan area distribusi kepada tim Meatfish.</p><a class="text-link" href="/daftar-supplier-meatfish/">Daftar Sebagai Pemasok →</a></div></article>
    </div>
  </div></section>
  <section class="section-tight alt"><div class="container">
    <div class="reference-section-head"><h2>Kategori produk untuk kebutuhan usaha</h2><p>Mulai dari kebutuhan menu dan volume pembelian. Konfirmasikan spesifikasi serta ketersediaan produk kepada tim.</p></div>
    <div class="grid service-grid">{products.map(product => <article class="card"><img src={product.image} alt={product.title} width="720" height="450" loading="lazy" decoding="async" /><div class="card-body"><h3>{product.title}</h3><p>{product.text}</p><a class="text-link" href="/produk-meatfish/">Lihat Katalog Produk →</a></div></article>)}</div>
  </div></section>
  <section class="section-tight"><div class="container">
    <div class="reference-section-head"><h2>Panduan bisnis dan kemitraan</h2><p>Pelajari persiapan usaha, pengelolaan stok, pemilihan pasokan, dan evaluasi kemitraan.</p></div>
    <PostCards posts={latest} /><p class="section-end"><a class="button secondary" href="/trend-daging-ikan-frozen/">Jelajahi Semua Panduan</a></p>
  </div></section>
  <section class="section-tight alt"><div class="container"><div class="cta cta-split"><div><h2>Belanja untuk kebutuhan sehari-hari?</h2><p>Lihat katalog produk dan informasi Meatfish langsung di website ini.</p></div><a class="button secondary" href="/produk-meatfish/">Lihat Produk →</a></div></div></section>
</BaseLayout>
