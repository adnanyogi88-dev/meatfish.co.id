---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BusinessPage from '../components/BusinessPage.astro';
import PostCards from '../components/PostCards.astro';
import Pagination from '../components/Pagination.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import routes from '../data/routes.json';
import { posts, allPosts, archivePosts, categories, indexablePagePaths } from '../lib/posts';
import { coreSlugs, categorySlug, formatDate, isPublished, publicationDate, updatedDate, postImage, categoriesFor } from '../lib/content-utils';
import { getContextualBacklinks } from '../data/contextual-backlinks';

export function getStaticPaths() {
  const unavailable = new Set(allPosts.filter(post => !isPublished(post.frontmatter)).map(post => `/${post.frontmatter.slug}/`));
  const paths = [...new Set([...routes.map(route => route.path), ...indexablePagePaths(), ...posts.map(post => `/${post.frontmatter.slug}/`)])]
    .filter(path => path !== '/' && !unavailable.has(path));
  return paths.map(path => ({ params: { slug: path.replace(/^\/|\/$/g, '') }, props: { path } }));
}
const { path } = Astro.props;
const clean = path.replace(/^\/|\/$/g, '');
const parts = clean.split('/');
const kind = parts[0];
const isArchive = kind === 'category' || kind === 'tag';
const isListing = clean === 'trend-daging-ikan-frozen' || /^trend-daging-ikan-frozen\/page\/\d+$/.test(clean);
const pageNumber = isListing ? Number(parts[2]) || 1 : isArchive && parts[2] === 'page' ? Number(parts[3]) || 1 : 1;
const archiveSlug = isArchive ? parts[1] : '';
const archiveBase = isArchive ? `/${kind}/${kind === 'category' ? categorySlug(archiveSlug) : archiveSlug}/` : '/trend-daging-ikan-frozen/';
const listedPosts = isListing ? posts : isArchive ? archivePosts(kind, archiveSlug) : [];
const pageCount = Math.ceil(listedPosts.length / 12);
const pagePosts = listedPosts.slice((pageNumber - 1) * 12, pageNumber * 12);
const post = !isArchive && !isListing ? posts.find(post => post.frontmatter.slug === clean) : undefined;
const staticType = coreSlugs.includes(clean) && !isListing ? clean : null;
const pretty = (value: string) => value.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
const pageMeta: Record<string, { title: string; description: string }> = {
  'gabung-kemitraan': { title: 'Kemitraan Toko Frozen Food Meatfish', description: 'Konsultasikan rencana kemitraan toko Meatfish, kebutuhan investasi, lokasi, produk, dan informasi penawaran bersama tim.' },
  'pasokan-untuk-bisnis': { title: 'Pasokan Daging, Ikan & Frozen Food untuk Bisnis', description: 'Minta informasi produk dan penawaran pasokan Meatfish untuk restoran, katering, reseller, serta usaha kuliner.' },
  'produk-meatfish': { title: 'Katalog Produk Meatfish untuk Kebutuhan Usaha', description: 'Lihat kategori daging, ikan, seafood, ayam, dan frozen food Meatfish. Konfirmasikan spesifikasi dan kebutuhan pembelian usaha kepada tim.' },
  'daftar-supplier-meatfish': { title: 'Daftar Pemasok Produk Meatfish', description: 'Ajukan profil usaha, produk, spesifikasi, kapasitas pasokan, dan area distribusi sebagai pemasok Meatfish.' },
  'tentang-meatfish': { title: 'Tentang Meatfish: Kemitraan & Pasokan B2B', description: 'Kenali informasi kemitraan toko, kebutuhan pasokan untuk usaha, dan pengajuan pemasok produk Meatfish.' },
  'lokasi-meat-fish': { title: 'Informasi Lokasi Toko Meatfish', description: 'Temukan informasi lokasi toko Meatfish dan konfirmasikan alamat serta jam operasional sebelum berkunjung.' },
};
const archiveTitle = kind === 'category' ? categories.find(category => category.slug === categorySlug(archiveSlug))?.name || pretty(archiveSlug) : pretty(archiveSlug);
const baseTitle = post?.frontmatter.title || (staticType && pageMeta[staticType]?.title) || (isListing ? 'Panduan Bisnis, Kemitraan & Frozen Food' : isArchive ? archiveTitle : pretty(parts.at(-1) || clean));
const title = `${baseTitle}${pageNumber > 1 ? ` – Halaman ${pageNumber}` : ''}`;
const description = post?.frontmatter.description || (staticType && pageMeta[staticType]?.description) || (isListing || isArchive ? `Jelajahi panduan Meatfish tentang ${isArchive ? archiveTitle.toLowerCase() : 'kemitraan, pasokan, dan pengelolaan bisnis frozen food'}.` : 'Lihat panduan bisnis dan informasi layanan Meatfish yang tersedia.');
const canonicalPath = isListing || isArchive ? pageNumber > 1 ? `${archiveBase}page/${pageNumber}/` : archiveBase : path;
const noindex = isListing || isArchive ? listedPosts.length === 0 || pageNumber > pageCount : !post && !staticType;
const image = post ? postImage(post.frontmatter) : '/wp-content/uploads/2025/10/mf-logo.webp';
const data = post?.frontmatter;
const authorName = data?.author && data.author !== 'administrator' ? data.author : 'Tim Meatfish';
const articleLd = data ? {
  '@context': 'https://schema.org', '@type': 'Article', headline: data.title,
  datePublished: publicationDate(data)?.toISOString(), dateModified: updatedDate(data)?.toISOString(),
  mainEntityOfPage: `https://meatfish.co.id${path}`,
  author: { '@type': /editorial|tim meatfish|meat & fish/i.test(authorName) ? 'Organization' : 'Person', name: authorName },
  publisher: { '@type': 'Organization', name: 'Meat & Fish', url: 'https://meatfish.co.id/' },
  image: new URL(image, Astro.site).href,
} : null;
const contextual = data ? getContextualBacklinks([data.title, data.description, ...categoriesFor(data)].join(' '), data.slug) : null;
const availableTargets = new Set([...posts.map(post => `https://meatfish.co.id/${post.frontmatter.slug}/`), ...coreSlugs.map(slug => `https://meatfish.co.id/${slug}/`)]);
const related = contextual && availableTargets.has(contextual.meatfishCoId.href) ? contextual.meatfishCoId : null;
const crumbs = post || isArchive || isListing ? [...(!isListing || pageNumber > 1 ? [{ name: 'Panduan Bisnis', url: '/trend-daging-ikan-frozen/' }] : []), { name: title, url: canonicalPath }] : [{ name: title, url: path }];
---
<BaseLayout title={`${title} | Meatfish`} description={description} image={image} type={post ? 'article' : 'website'} noindex={noindex} canonicalPath={canonicalPath}>
  <Breadcrumbs items={crumbs} />
  {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
  {post ? <>
    <header class="page-head container"><span class="pill">{categoriesFor(data)[0]}</span><h1>{baseTitle}</h1><p class="article-meta">Terbit <time datetime={publicationDate(data)?.toISOString()}>{formatDate(publicationDate(data))}</time> · Oleh {authorName}</p></header>
    <div class="container article-layout"><article class="article-content">
      <img class="article-featured" src={image} alt={data.imageAlt || data.image_alt || data.title} width="1200" height="675" fetchpriority="high" decoding="async" />
      <post.Content />
      {related && <aside class="related-article"><span>Panduan terkait</span><p><a href={related.href}>{related.label}</a></p></aside>}
      <section class="cta"><h2>Konsultasikan kebutuhan usaha Anda</h2><p>Bahas rencana <a href="/gabung-kemitraan/">kemitraan toko</a> atau <a href="/pasokan-untuk-bisnis/">kebutuhan pasokan B2B</a> bersama tim Meatfish.</p><WhatsAppButton label="Hubungi Tim Meatfish" purpose={/franchise|kemitraan|waralaba/i.test(data.title) ? 'kemitraan' : 'b2b'} /></section>
    </article><aside class="sidebar"><h2>Panduan terbaru</h2>{posts.filter(item => item.frontmatter.slug !== data.slug).slice(0, 6).map(item => <a href={`/${item.frontmatter.slug}/`}>{item.frontmatter.title}</a>)}<h2>Topik</h2>{categories.map(category => <a href={`/category/${category.slug}/`}>{category.name}</a>)}</aside></div>
  </> : isArchive || isListing ? <section class="section"><div class="container">
    <header class="page-head"><h1>{title}</h1><p class="lead">{description}</p></header>
    {pagePosts.length > 0 ? <><PostCards posts={pagePosts} level={2} /><Pagination current={pageNumber} total={pageCount} base={archiveBase} /></> : <div class="business-content"><p>Belum ada panduan yang tersedia pada halaman ini. Jelajahi panduan bisnis dan produk melalui halaman berikut.</p><a class="button secondary" href="/trend-daging-ikan-frozen/">Lihat Panduan Meatfish</a></div>}
  </div></section> : staticType ? <BusinessPage slug={staticType} /> : <section class="section"><div class="container business-content">
    <header class="page-head"><h1>{title}</h1></header><p>Informasi lengkap untuk halaman ini belum tersedia. Anda dapat menjelajahi panduan yang sudah diterbitkan atau menghubungi tim untuk informasi produk dan layanan Meatfish.</p>
    <div class="reference-actions"><a class="button secondary" href="/trend-daging-ikan-frozen/">Jelajahi Panduan</a><WhatsAppButton label="Hubungi Tim Meatfish" /></div>
  </div></section>}
</BaseLayout>
