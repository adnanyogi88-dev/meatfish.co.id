---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import analytics from "../data/analytics.json";
import "../styles/global.css";
const {
  title = "Meatfish | Kemitraan Frozen Food & Pasokan untuk Bisnis",
  description = "Kenali kemitraan toko Meatfish dan konsultasikan kebutuhan pasokan daging, ikan, seafood, serta frozen food untuk usaha Anda.",
  image = "/wp-content/uploads/2025/10/mf-logo.webp",
  type = "website",
  noindex = false,
  canonicalPath = Astro.url.pathname,
  redirectTo = '',
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const gtmId = !redirectTo && /^GTM-[A-Z0-9]+$/.test(import.meta.env.PUBLIC_GTM_ID || '') ? import.meta.env.PUBLIC_GTM_ID : '';
const configuredGa4Id = /^G-[A-Z0-9]+$/.test(import.meta.env.PUBLIC_GA4_ID || '') ? import.meta.env.PUBLIC_GA4_ID : analytics.ga4MeasurementId;
const ga4Id = !redirectTo && !gtmId && /^G-[A-Z0-9]+$/.test(configuredGa4Id) ? configuredGa4Id : '';
const organization = {
  "@context": "https://schema.org", "@type": "Organization", name: "Meat & Fish",
  url: "https://meatfish.co.id", logo: new URL("/wp-content/uploads/2025/10/mf-logo.webp", Astro.site).href
};
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <title>{title}</title><meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {redirectTo && <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />}
    <meta property="og:type" content={type} /><meta property="og:title" content={title} />
    <meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    {gtmId && <script is:inline define:vars={{ gtmId }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
    </script>}
    {ga4Id && <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
      <script is:inline define:vars={{ ga4Id }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function(){window.dataLayer.push(arguments);};
        window.gtag('js', new Date());
        var debugMode = new URLSearchParams(window.location.search).get('ga_debug') === '1';
        window.gtag('config', ga4Id, debugMode ? { debug_mode: true } : {});
      </script>
    </>}
  </head>
  <body>
    {gtmId && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}
    <Header />
    <main><slot /></main>
    <Footer />
    <a class="floating-wa" href="https://wa.link/89ffhn" target="_blank" aria-label="Chat WhatsApp" rel="nofollow noopener noreferrer" data-purpose="umum"><img src="/images/WhatsApp_icon.png" alt="" /></a>
    <script is:inline define:vars={{ directAnalytics: Boolean(ga4Id) }}>
      (function () {
        var messagePrefix =
          "Halo Meatfish, saya ingin bertanya tentang produk seafood, daging, ayam, atau frozen food. Saya datang dari halaman: ";

        function isWhatsAppLink(href) {
          try {
            var hostname = new URL(href, window.location.origin).hostname.toLowerCase();
            return hostname === "wa.me" ||
              hostname.endsWith(".wa.me") ||
              hostname === "wa.link" ||
              hostname.endsWith(".wa.link") ||
              hostname === "api.whatsapp.com" ||
              hostname === "whatsapp.com" ||
              hostname.endsWith(".whatsapp.com");
          } catch (error) {
            return false;
          }
        }

        function buildWhatsAppUrl(originalUrl, link) {
          try {
            var url = new URL(originalUrl, window.location.origin);
            // wa.link owns its prefilled message; adding a text query is not supported.
            if (url.hostname === 'wa.link' || url.hostname.endsWith('.wa.link')) return url.toString();
            var message = (link.getAttribute('data-message') || url.searchParams.get('text') || messagePrefix) + '\nHalaman: ' + document.title + ' - ' + window.location.href;
            url.searchParams.set("text", message);
            return url.toString();
          } catch (error) {
            return originalUrl;
          }
        }

        function prepareWhatsAppLink(link) {
          var href = link.getAttribute("href") || "";
          if (!isWhatsAppLink(href)) return false;

          var originalUrl = link.getAttribute('data-original-href') || link.href;
          link.setAttribute('data-original-href', originalUrl);
          link.setAttribute("href", buildWhatsAppUrl(originalUrl, link));
          link.setAttribute("target", "_blank");
          link.setAttribute("rel", "nofollow noopener noreferrer");
          link.setAttribute("data-track", "whatsapp");
          return true;
        }

        function setupWhatsAppTracking() {
          document.querySelectorAll("a[href]").forEach(prepareWhatsAppLink);

          document.addEventListener("click", function (event) {
            var link = event.target instanceof Element ? event.target.closest("a[href]") : null;
            if (!link) return;
            var isWhatsApp = prepareWhatsAppLink(link);
            if (!isWhatsApp && link.getAttribute('data-track') !== 'catalog') return;
            var eventName = isWhatsApp ? 'whatsapp_click' : 'catalog_click';
            var params = {
              source_page_path: window.location.pathname,
              source_page_title: document.title,
              cta_purpose: link.getAttribute('data-purpose') || 'umum',
              button_text: (link.innerText || link.textContent || link.getAttribute("aria-label") || "WhatsApp CTA").trim()
            };
            window.dataLayer = window.dataLayer || [];
            if (directAnalytics && typeof window.gtag === 'function') window.gtag('event', eventName, params);
            else window.dataLayer.push(Object.assign({ event: eventName }, params));
          });

          new MutationObserver(function (mutations) {
            mutations.forEach(function (mutation) {
              mutation.addedNodes.forEach(function (node) {
                if (node.nodeType !== 1) return;
                if (node.matches && node.matches("a[href]")) prepareWhatsAppLink(node);
                if (node.querySelectorAll) node.querySelectorAll("a[href]").forEach(prepareWhatsAppLink);
              });
            });
          }).observe(document.body, { childList: true, subtree: true });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", setupWhatsAppTracking);
        } else {
          setupWhatsAppTracking();
        }
      })();
    </script>
  </body>
</html>
